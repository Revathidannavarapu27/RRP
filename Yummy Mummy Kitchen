        const grid = document.getElementById("recipeGrid");

        function displayRecipes(list) {
            grid.innerHTML = "";
            list.forEach((recipe, index) => {
                const card = document.createElement("div");
                card.className = "recipe-card";
                card.innerHTML = `
                    <img src="${recipe.image}" alt="${recipe.title}" class="recipe-image" />
                    <div class="recipe-details">
                        <span class="recipe-tag">${recipe.tag}</span>
                        <h3 class="recipe-title">${recipe.title}</h3>
                        <p class="recipe-description">${recipe.description}</p>
                    </div>
                `;
                card.onclick = () => viewRecipe(index);
                grid.appendChild(card);
            });
        }

        function viewRecipe(index) {
            localStorage.setItem("selectedRecipe", JSON.stringify(recipes[index]));
            window.location.href = "recipe-details.html";
        }

        function searchRecipe() {
            const query = document.getElementById("searchInput").value.toLowerCase();
            const result = recipes.find(r => r.title.toLowerCase().includes(query));
            if (result) {
                localStorage.setItem("selectedRecipe", JSON.stringify(result));
                window.location.href = "recipe-details.html";
            } else {
                alert("Recipe not found!");
            }
        }

        // Initialize
        displayRecipes(recipes.slice(0,4));
